# ---- Server ----
NODE_ENV=development
PORT=5001
# Where the React app is served from in development (used for CORS)
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/karthi-clothing

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Initial admin account created by `npm run seed` (change the password!)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345

# ---- Uploads ----
UPLOAD_DIR=uploads

# ---- Business details (shown on the website; edit freely) ----
BUSINESS_NAME=Karthi Clothing Co.
BUSINESS_TAGLINE=Style for Everyday Life.
BUSINESS_PHONE=+91 00000 00000
# Digits only, with country code, no + (e.g. 919876543210)
BUSINESS_WHATSAPP=910000000000
BUSINESS_EMAIL=hello@example.com
BUSINESS_ADDRESS=Your street address, City, Tamil Nadu, India - 000000
BUSINESS_HOURS=Mon - Sat, 9:30 AM - 7:00 PM
# Paste the "src" URL from Google Maps > Share > Embed a map (optional)
BUSINESS_MAP_EMBED_URL=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
